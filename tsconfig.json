{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/app-ui/*": ["./vendor/ouaqt-website/app-ui/*"],
      "@/*": ["./src/*"],
      "@electron/*": ["./electron/*"],
      "@app-ui/*": ["./vendor/ouaqt-website/app-ui/*"]
    }
  },
  "include": ["src", "electron", "scripts", "web", "vite.config.ts", "vite.web.config.ts", "vendor/ouaqt-website/app-ui"]
}
